# Second Brain Configuration — Telegram capture bot + nightly summarizer
# Copy this file to .env and fill in your values

# Your Telegram bot token (get it from @BotFather)
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Webhook Configuration
# Public URL where Telegram will send updates (use ngrok for local development)
# Example: https://your-domain.com or https://abc123.ngrok.io
WEBHOOK_URL=https://your-domain.com

# Port for webhook server (8443, 443, 80, or 88 - Telegram requirement)
WEBHOOK_PORT=8443

# Webhook path (will be combined with bot token for security)
# Final webhook URL will be: WEBHOOK_URL/webhook/BOT_TOKEN
WEBHOOK_PATH=/webhook

# Google OAuth 2.0 Configuration
# Get these from Google Cloud Console after creating OAuth 2.0 credentials
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/oauth/callback

# Database Configuration (Session Pooler)
DATABASE_USER=dbUser
DATABASE_PASSWORD=dbPassword
DATABASE_HOST=dbHost
DATABASE_PORT=dbPort
DATABASE_NAME=dbName

# Token Encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-fernet-encryption-key

# Google Drive Settings
# Name of the Drive folder the bot creates; daily notes are stored inside it as
# YYYY-MM-DD.md files.
DRIVE_FOLDER_NAME=second_brain_bot/

# Folder the second-brain service writes processed/filtered knowledge notes
# to (distinct from the raw inbox above). /search reads from here.
KNOWLEDGE_FOLDER_NAME=second_brain_knowledge/

# Optional: pin the knowledge folder by Drive id instead of by name. Takes
# precedence over KNOWLEDGE_FOLDER_NAME when set, and works no matter how
# deeply the folder is nested inside other folders. Copy the id from the
# folder's Drive link: drive.google.com/drive/folders/<THIS PART>?usp=...
KNOWLEDGE_FOLDER_ID=

# Day cutoff hour (0-23, default 0 = disabled).
# Messages received before this hour are saved to the *previous* day's file.
# Example: DAY_CUTOFF_HOUR=4 means anything sent between 00:00-03:59 goes into yesterday's file.
DAY_CUTOFF_HOUR=0

# Shared secret for the POST /api/send-message endpoint.
# Leave unset to disable the endpoint entirely (returns 503).
# Generate with: openssl rand -hex 32
OUTBOUND_API_SECRET=

# OpenRouter LLM, shared by /timebox scheduling and /search's vault agent
# Required: OpenRouter API key (https://openrouter.ai/keys). Startup fails without it.
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional overrides (defaults shown)
LLM_MODEL=deepseek/deepseek-v4-flash

# Timezone used across the bot and the summarizer: /timebox target-day math,
# DAY_CUTOFF_HOUR file-naming, and the summarizer's "today"/"yesterday".
# TIMEBOX_TIMEZONE is a deprecated alias, still honored with a warning.
APP_TIMEZONE=Asia/Singapore

# Sessions finishing before this local hour plan the *current* day, not tomorrow.
# Separate concept from DAY_CUTOFF_HOUR above.
TIMEBOX_CUTOFF_HOUR=3

# --- Timebox -> Google Calendar publishing ---
# Calendar ID of a DEDICATED calendar the bot writes the schedule into.
# Never use your primary calendar. Find it in Google Calendar:
#   Settings -> <calendar> -> Integrate calendar -> Calendar ID
# Requires the Google Calendar API enabled in the same GCP project and the
# calendar.events scope (re-run /authenticate after upgrading).
# Leave unset to reply the schedule as text only (no calendar write).
TIMEBOX_CALENDAR_ID=

# Fixed daily anchors passed to the planner as overridable defaults.
# Times are HH:MM (24h); durations are minutes. A task that mentions a different
# time overrides the matching default for that day.
TIMEBOX_DAY_START=09:00
TIMEBOX_DAY_END=23:59
TIMEBOX_LUNCH=12:30
TIMEBOX_DINNER=19:00
TIMEBOX_EAT_DURATION=60
# Work window (Office/WFH days only): the narrower band inside the day where
# work tasks live. Work end is preferred (soft); the hard end is never crossed.
TIMEBOX_WORK_START=09:00
TIMEBOX_WORK_END=17:00
TIMEBOX_WORK_END_HARD=18:00
# Commute blocks are only added in Office mode (chosen per session).
TIMEBOX_COMMUTE_MORNING=08:00
TIMEBOX_COMMUTE_EVENING=18:00
TIMEBOX_COMMUTE_DURATION=45

# --- Nightly summarizer (`second-brain summarize`) ---

# Path to the Google OAuth token JSON file used for Drive access (a service
# account-style refresh token, distinct from the per-user bot OAuth flow
# above). Can also be set as GOOGLE_TOKEN_JSON (the token's JSON *content*,
# for CI/headless environments where writing a file to disk isn't practical).
GOOGLE_SERVICE_REFRESH_TOKEN=./token.json

# Drive folder ID containing the daily YYYY-MM-DD.md dump files the bot writes.
INPUT_DRIVE_FOLDER_ID=

# Drive folder ID for the knowledge base (vault) the summarizer organizes
# messages into. Fallback aliases OUTPUT_DRIVE_FOLDER_ID, then
# KNOWLEDGE_FOLDER_ID, are still honored with a deprecation warning.
VAULT_FOLDER_ID=

# Telegram chat ID the summarizer sends its run summary and to-do digest to.
# Fallback alias TELEGRAM_CHAT_ID is still honored with a deprecation warning.
SUMMARY_CHAT_ID=

# Directory for per-run debug log files, relative to the repo root. Empty
# (the default) means stdout-only logging, since Fly captures stdout
# directly — set this locally (e.g. SUMMARIZER_LOG_DIR=tmp) if you want a
# per-run trace file on disk.
SUMMARIZER_LOG_DIR=

# Wall-clock budget (seconds) for one `summarize` run, enforced with
# signal.alarm. Keep this below the job machine's external `timeout -k 60
# 2100` wrapper so our own alarm fires first and reports a clean Telegram
# failure notice instead of the process just vanishing to SIGTERM/SIGKILL.
SUMMARIZER_MAX_SECONDS=2100

# Optional: explicit path to config.yaml (checked before ./config.yaml and
# the repo root). Rarely needed — mainly useful for a non-editable install
# running from a working directory that doesn't have config.yaml alongside it.
SECOND_BRAIN_CONFIG=